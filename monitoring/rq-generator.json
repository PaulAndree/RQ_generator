{
  "title": "RQ generator",
  "uid": "rq-generator",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "rq-generator"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Documents in latest run",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status,environment) (rq_documents_total)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Mean document duration",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rq_job_duration_seconds_sum / rq_job_duration_seconds_count"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pipeline logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"rq-generator\"}"
        }
      ]
    }
  ]
}
