# URLs refer to existing shared services. Check actual port mappings.
OCR_BASE_URL=http://127.0.0.1:8084
CHUNKING_URL=http://127.0.0.1:8085
OLLAMA_BASE_URL=http://127.0.0.1:11436
OLLAMA_MODEL=qwen3:14b
OLLAMA_CONTEXT_TOKENS=32768
OLLAMA_OUTPUT_TOKENS=8192
SERVICE_TIMEOUT_SECONDS=600
SERVICE_RETRIES=2
CHUNK_MAX_TOKENS=800
OUTPUT_DIR=output
# Optional, defaults to ~/.cache/rq-generator/vocabularies
# VOCABULARY_DIR=/path/to/cached/official/releases
APP_ENV=local
LOKI_URL=http://127.0.0.1:3101
PUSHGATEWAY_URL=http://127.0.0.1:9095
PROMETHEUS_URL=http://127.0.0.1:9094
# Documented project port is 3013; the current shared deployment uses 3005.
GRAFANA_URL=http://127.0.0.1:3005
GRAFANA_TOKEN=
LANGFUSE_BASE_URL=http://127.0.0.1:3006
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Explicitly opt in only when document text may be sent to telemetry backends.
TRACE_CAPTURE_CONTENT=false
